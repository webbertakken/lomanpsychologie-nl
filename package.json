{
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-husky.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt --write",
    "lint": "yarn oxlint --report-unused-disable-directives",
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "prepare": "husky",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts|js|jsx|mjs|cjs)": [
      "oxlint --fix --report-unused-disable-directives --no-error-on-unmatched-pattern",
      "oxfmt --write"
    ],
    "*.@(json|jsonc|json5|md|mdx|yaml|yml|css|scss|sass|html|toml)": "oxfmt --write",
    ".github/workflows/*.@(yml|yaml)": "actionlint"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.0.0",
    "@contentful/rich-text-types": "^17.0.0",
    "@headlessui/react": "^2.0.0",
    "@loadable/component": "^5.15.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tippyjs/react": "^4.2.6",
    "classnames": "^2.3.2",
    "contentful": "^11.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.0.0",
    "react-spring": "10.0.4",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "happy-dom": "^21.0.4",
    "husky": "9",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "postcss": "^8.4.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "contentful": {
      "built": true
    },
    "sharp": {
      "built": true
    }
  },
  "engines": {
    "node": "24.x"
  }
}
